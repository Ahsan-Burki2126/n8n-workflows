    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer name: {{ $json['Name '] }}\nCustomer message: {{ $json.Message }}\nWrite the reply email.",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a calm and caring customer support assistant for a small online business. Your job is to reply to existing customers who have a problem or question about an order, delivery, or product.  Rules: - Write 3 to 4 short sentences. -  Write only the main 2 sentences. Do not include a greeting or a sign-off.. - Acknowledge their specific problem and apologise for the trouble. - Never promise refunds, replacements, compensation, or delivery dates. - Say that the support team has received their message and will look into it and follow up soon. - End with a friendly sign-off from \"The Support Team\". - Write only the email body. No subject line, no placeholders like [Your Name]."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        592,
        -16
      ],
      "id": "db57757f-8be4-4b4d-9797-05a858370717",
      "name": "Support Reply"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Customer name: {{ $('Append row in sheet').item.json['Name '] }}\nCustomer message: {{ $('Append row in sheet').item.json.Message }}\n\nWrite the reply email.",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a friendly sales assistant for a small online business. Your job is to reply to potential customers who are interested in buying or want to know about prices, services, or packages.  Rules: - Write 3 to 4 short sentences. - Write only the main 2 sentences. Do not include a greeting or a sign-off. - Be warm and enthusiastic, and thank them for their interest. - Do not mention any specific prices, discounts, or delivery dates. - Say that a team member will contact them soon with full details..- Do not describe or list any products, services, packages, features, or prices. Only thank them for their interest and say a team member will be in touch with details. - End with a friendly sign-off from \"The Team\". - Write only the email body. No subject line, no placeholders like [Your Name]."
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
        592,
        -320
      ],
      "id": "65198ec4-36c0-456a-a09b-e419852b7622",
      "name": "Sales Reply"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Name: {{ $('Append row in sheet').item.json['Name '] }}\nMessage: {{ $('On form submission').item.json.Message }}\n\nWrite the reply, or NO_REPLY if it is spam.",
        "messages": {
          "messageValues": [
            {
              "message": "=You are a polite assistant for a small online business. You reply to messages that are not about buying something and not about an existing order, such as compliments, feedback, job questions, or partnership requests.  Rules: - Write 2 to 3 short sentences. -  Write only the main 2 sentences. Do not include a greeting or a sign-off. Only say that their message has been received. Do not say it was forwarded to anyone, and do not mention any team or department. - Do not promise that anyone will contact them. - Write only the email body. No subject line, no placeholders like [Your Name],- Do not answer any questions or state any facts about the business (such as jobs, prices, or availability). Only thank them and confirm their message was received. - Always end with a new line containing only: The Team"
            }
          ]
        },
        "batching": {}
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.9,
      "position": [
