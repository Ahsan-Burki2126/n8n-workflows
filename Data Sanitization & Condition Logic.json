    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  // 1. Standardize Name\n  let rawName = item.json.body.name || item.json.name || \"\";\n  item.json.cleanName = rawName.charAt(0).toUpperCase() + rawName.slice(1).toLowerCase();\n  \n  // 2. Clean Phone\n  let rawPhone = item.json.body.phone || item.json.phone || \"\";\n  item.json.cleanPhone = rawPhone.replace(/\\D/g, '');\n\n  // 3. Clean Email\n  let rawEmail = item.json.body.email || item.json.email || \"\";\n  item.json.cleanEmail = rawEmail.trim().toLowerCase();\n}\nreturn $input.all();"
      },
